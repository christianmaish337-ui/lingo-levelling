<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LINGO-LEVELLING</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #0b0f14;
    color: #f1f5f9;
}

.container {
    max-width: 700px;
    margin: auto;
    padding: 20px;
}

h1 {
    text-align: center;
    margin-bottom: 5px;
    letter-spacing: 2px;
}

.subtitle {
    text-align: center;
    color: #94a3b8;
    margin-bottom: 25px;
}

.card {
    background: #151b23;
    border: 1px solid #263241;
    border-radius: 16px;
    padding: 18px;
    margin-bottom: 18px;
}

h2, h3 {
    margin-top: 0;
}

button {
    width: 100%;
    padding: 13px;
    margin-top: 10px;
    border: none;
    border-radius: 10px;
    background: #2563eb;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    opacity: 0.9;
}

button.danger {
    background: #991b1b;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    margin-top: 8px;
    margin-bottom: 12px;
    border-radius: 9px;
    border: 1px solid #334155;
    background: #0f172a;
    color: white;
    font-size: 15px;
}

.language-buttons {
    display: flex;
    gap: 10px;
}

.language-buttons button {
    flex: 1;
}

.language-buttons button.active {
    background: #16a34a;
}

.rank {
    text-align: center;
    font-size: 27px;
    font-weight: bold;
    margin: 10px 0;
}

.native {
    text-align: center;
    color: #94a3b8;
    font-size: 18px;
}

.total {
    text-align: center;
    font-size: 35px;
    font-weight: bold;
    margin: 12px 0;
}

.progress-container {
    height: 18px;
    background: #273244;
    border-radius: 20px;
    overflow: hidden;
}

.progress {
    height: 100%;
    width: 0%;
    background: #22c55e;
    transition: width 0.4s ease;
}

.progress-text {
    text-align: center;
    margin-top: 8px;
    color: #94a3b8;
}

.stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.stat {
    background: #0f172a;
    padding: 14px;
    border-radius: 10px;
    text-align: center;
}

.stat-number {
    font-size: 22px;
    font-weight: bold;
}

.stat-label {
    color: #94a3b8;
    font-size: 13px;
}

.history-item {
    border-bottom: 1px solid #273244;
    padding: 12px 0;
}

.history-item:last-child {
    border-bottom: none;
}

.small {
    color: #94a3b8;
    font-size: 13px;
}

.hidden {
    display: none;
}
</style>
</head>

<body>

<div class="container">

    <h1>LINGO-LEVELLING</h1>
    <div class="subtitle">Duo-Linguo Training HQ</div>

    <div class="card">
        <h2>Choose Language</h2>

        <div class="language-buttons">
            <button id="koreanBtn" onclick="selectLanguage('korean')">
                🇰🇷 Korean
            </button>

            <button id="japaneseBtn" onclick="selectLanguage('japanese')">
                🇯🇵 Japanese
            </button>
        </div>
    </div>

    <div class="card">

        <h2 id="languageTitle">Korean</h2>

        <div class="rank" id="rankName">
            🌱 Choboseong
        </div>

        <div class="native" id="rankNative">
            초보생
        </div>

        <div class="total">
            <span id="totalMinutes">0</span> min
        </div>

        <div class="progress-container">
            <div class="progress" id="progressBar"></div>
        </div>

        <div class="progress-text" id="progressText">
            300 minutes to next rank
        </div>

    </div>

    <div class="card">

        <h2>Add Study Time</h2>

        <label>Minutes</label>
        <input
            type="number"
            id="minutesInput"
            min="1"
            placeholder="e.g. 30"
        >

        <label>Note</label>
        <textarea
            id="noteInput"
            rows="3"
            placeholder="What did you study?"
        ></textarea>

        <button onclick="addTime()">
            + ADD STUDY TIME
        </button>

    </div>

    <div class="card">

        <h2>Statistics</h2>

        <div class="stat-grid">

            <div class="stat">
                <div class="stat-number" id="statMinutes">0</div>
                <div class="stat-label">Minutes</div>
            </div>

            <div class="stat">
                <div class="stat-number" id="statHours">0</div>
                <div class="stat-label">Hours</div>
            </div>

            <div class="stat">
                <div class="stat-number" id="statSessions">0</div>
                <div class="stat-label">Sessions</div>
            </div>

            <div class="stat">
                <div class="stat-number" id="statRemaining">300</div>
                <div class="stat-label">To Next Rank</div>
            </div>

        </div>

    </div>

    <div class="card">

        <h2>History</h2>

        <div id="history">
            <div class="small">
                No study sessions yet.
            </div>
        </div>

    </div>

    <div class="card">

        <h3>Danger Zone</h3>

        <button class="danger" onclick="resetLanguage()">
            Reset Current Language
        </button>

    </div>

</div>

<script>

const ranks = {

    korean: [
        { name: "🌱 Choboseong", native: "초보생", min: 0 },
        { name: "📚 Haksaeng", native: "학생", min: 300 },
        { name: "🥋 Musa", native: "무사", min: 1800 },
        { name: "⚔️ Geomsa", native: "검사", min: 3600 },
        { name: "🏹 Gungsa", native: "궁사", min: 6000 },
        { name: "🐯 Horangi", native: "호랑이", min: 12000 },
        { name: "👹 Dokkaebi", native: "도깨비", min: 21000 },
        { name: "🐉 Yong", native: "용", min: 30000 },
        { name: "⚡ Cheonsin", native: "천신", min: 45000 },
        { name: "👑 Janggun", native: "장군", min: 60000 },
        { name: "🌌 Sin", native: "신", min: 90000 }
    ],

    japanese: [
        { name: "🌱 Shoshinsha", native: "初心者", min: 0 },
        { name: "📚 Gakusei", native: "学生", min: 300 },
        { name: "🥷 Ninja", native: "忍者", min: 1800 },
        { name: "⚔️ Samurai", native: "侍", min: 3600 },
        { name: "🧘 Sensei", native: "先生", min: 6000 },
        { name: "👹 Oni", native: "鬼", min: 12000 },
        { name: "🐲 Kaiju", native: "怪獣", min: 21000 },
        { name: "⚡ Raijin", native: "雷神", min: 30000 },
        { name: "🐉 Ryūjin", native: "龍神", min: 45000 },
        { name: "👑 Shōgun", native: "将軍", min: 60000 },
        { name: "🌌 Kami", native: "神", min: 90000 }
    ]

};

let currentLanguage = "korean";

function storageKey() {
    return "lingo_" + currentLanguage;
}

function getData() {

    const saved = localStorage.getItem(storageKey());

    if (!saved) {
        return {
            minutes: 0,
            history: []
        };
    }

    return JSON.parse(saved);
}

function saveData(data) {

    localStorage.setItem(
        storageKey(),
        JSON.stringify(data)
    );

}

function getCurrentRank(minutes) {

    const languageRanks = ranks[currentLanguage];

    let current = languageRanks[0];

    for (let i = 0; i < languageRanks.length; i++) {

        if (minutes >= languageRanks[i].min) {
            current = languageRanks[i];
        }

    }

    return current;
}

function getNextRank(minutes) {

    const languageRanks = ranks[currentLanguage];

    for (let i = 0; i < languageRanks.length; i++) {

        if (minutes < languageRanks[i].min) {
            return languageRanks[i];
        }

    }

    return null;
}

function updateUI() {

    const data = getData();

    const languageRanks = ranks[currentLanguage];

    const current = getCurrentRank(data.minutes);

    const next = getNextRank(data.minutes);

    document.getElementById("languageTitle").textContent =
        currentLanguage === "korean"
        ? "🇰🇷 Korean"
        : "🇯🇵 Japanese";

    document.getElementById("rankName").textContent =
        current.name;

    document.getElementById("rankNative").textContent =
        current.native;

    document.getElementById("totalMinutes").textContent =
        data.minutes;

    document.getElementById("statMinutes").textContent =
        data.minutes;

    document.getElementById("statHours").textContent =
        (data.minutes / 60).toFixed(1);

    document.getElementById("statSessions").textContent =
        data.history.length;

    if (next) {

        const range = next.min - current.min;
        const progress = data.minutes - current.min;

        let percentage =
            (progress / range) * 100;

        percentage = Math.max(
            0,
            Math.min(100, percentage)
        );

        document.getElementById("progressBar").style.width =
            percentage + "%";

        document.getElementById("progressText").textContent =
            `${next.min - data.minutes} minutes to ${next.name}`;

        document.getElementById("statRemaining").textContent =
            next.min - data.minutes;

    } else {

        document.getElementById("progressBar").style.width =
            "100%";

        document.getElementById("progressText").textContent =
            "🌌 MAXIMUM RANK REACHED";

        document.getElementById("statRemaining").textContent =
            "MAX";

    }

    renderHistory();

    document.getElementById("koreanBtn")
        .classList.toggle(
            "active",
            currentLanguage === "korean"
        );

    document.getElementById("japaneseBtn")
        .classList.toggle(
            "active",
            currentLanguage === "japanese"
        );

}

function selectLanguage(language) {

    currentLanguage = language;

    updateUI();

}

function addTime() {

    const input =
        document.getElementById("minutesInput");

    const note =
        document.getElementById("noteInput");

    const minutes =
        parseInt(input.value);

    if (!minutes || minutes <= 0) {

        alert("Enter a valid number of minutes.");

        return;
    }

    const data = getData();

    const oldRank =
        getCurrentRank(data.minutes);

    data.minutes += minutes;

    data.history.unshift({

        minutes: minutes,

        note: note.value.trim(),

        date: new Date().toLocaleString()

    });

    saveData(data);

    const newRank =
        getCurrentRank(data.minutes);

    if (newRank.min > oldRank.min) {

        alert(
            "🎉 RANK UP!\n\n" +
            newRank.name +
            "\n" +
            newRank.native
        );

    }

    input.value = "";
    note.value = "";

    updateUI();

}

function renderHistory() {

    const historyDiv =
        document.getElementById("history");

    const data = getData();

    if (data.history.length === 0) {

        historyDiv.innerHTML =
            '<div class="small">No study sessions yet.</div>';

        return;

    }

    historyDiv.innerHTML = "";

    data.history.forEach(session => {

        const item =
            document.createElement("div");

        item.className = "history-item";

        item.innerHTML = `
            <strong>+${session.minutes} minutes</strong>
            <div class="small">${session.date}</div>
            ${
                session.note
                ? `<div>${session.note}</div>`
                : ""
            }
        `;

        historyDiv.appendChild(item);

    });

}

function resetLanguage() {

    const confirmed =
        confirm(
            "Reset ALL progress for " +
            currentLanguage +
            "?"
        );

    if (!confirmed) return;

    localStorage.removeItem(storageKey());

    updateUI();

}

updateUI();

</script>

</body>
  </html>
